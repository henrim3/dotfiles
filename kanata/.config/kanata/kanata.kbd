(defcfg
  process-unmapped-keys yes

  linux-dev-names-exclude (
    "GEIST TOTEM Keyboard"
    "GEIST TOTEM Consumer Control"
    "GEIST TOTEM System Control"
    "GEIST TOTEM"
  )
)

(defsrc
  s d f h j k l
  lctl rctl lalt ralt lsft rsft lmet rmet
  left down up right
)

(defvar
  tap-time 200
  hold-time 175
)

(defalias
  s (tap-hold $tap-time $hold-time s lctrl)
  d (tap-hold $tap-time $hold-time d lalt)
  f (tap-hold 150 $hold-time f lsft)

  j (tap-hold 150 $hold-time j rsft)
  k (tap-hold $tap-time $hold-time k lalt)
  l (tap-hold $tap-time $hold-time l rctrl)

  layer1 (layer-while-held layer1)
)

(deflayer base
  @s @d @f h @j @k @l  
  lctl rctl @layer1 ralt lsft rsft lmet rmet
  left down up right
)

(deflayer layer1
  XX XX XX left down up right
  XX XX XX XX XX XX XX XX
  XX XX XX XX
)
